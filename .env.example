# NexRide environment contract
# Copy to .env.local for local development. Never commit .env.local or any file containing real secrets.
# Vercel should store real values in Development / Preview / Production scopes.

# PUBLIC — safe for the browser. NEXT_PUBLIC_* values are embedded at build time.
NEXT_PUBLIC_APP_NAME=NexRide
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Legacy compatibility only; prefer the publishable key above.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJreplace_me
NEXT_PUBLIC_MAPBOX_TOKEN=pk.replace_me

# SERVER — never expose these with NEXT_PUBLIC_.
APP_ENV=development
APP_URL=http://localhost:3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Legacy compatibility only; prefer SUPABASE_SECRET_KEY.
# SUPABASE_SERVICE_ROLE_KEY=replace_me

# Feature gates
NEXRIDE_MAPS_ENABLED=true
NEXRIDE_PAYMENTS_ENABLED=false
NEXRIDE_SMS_ENABLED=false
NEXRIDE_PUSH_ENABLED=false
NEXRIDE_REDIS_ENABLED=false
NEXRIDE_SERVER_ADMIN_ENABLED=true

# Payments (server-only)
PAYMENT_PROVIDER=none
PAYMENT_SECRET_KEY=replace_me
PAYMENT_WEBHOOK_SECRET=replace_me
PAYMENT_PUBLIC_KEY=replace_me

# SMS / OTP (server-only)
SMS_PROVIDER=none
SMS_ACCOUNT_ID=replace_me
SMS_AUTH_TOKEN=replace_me
SMS_FROM=replace_me
OTP_SIGNING_SECRET=replace_me

# Push notifications (server-only)
FCM_PROJECT_ID=replace_me
FCM_CLIENT_EMAIL=replace_me
FCM_PRIVATE_KEY=replace_me
APNS_KEY_ID=replace_me
APNS_TEAM_ID=replace_me
APNS_BUNDLE_ID=com.nexride.app
APNS_PRIVATE_KEY=replace_me

# Redis / rate-limit / dispatch cache (server-only)
REDIS_URL=redis://localhost:6379
REDIS_TOKEN=replace_me

# Optional observability
SENTRY_DSN=replace_me
SENTRY_AUTH_TOKEN=replace_me

# Optional public analytics id — only if the provider documents it as public.
# NEXT_PUBLIC_ANALYTICS_ID=replace_me
