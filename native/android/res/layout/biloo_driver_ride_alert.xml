<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/biloo_ride_alert_background">
    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/biloo_ride_notification" android:tint="#F5C75E" android:importantForAccessibility="no" android:layout_marginEnd="10dp"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/biloo_alert_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/biloo_alert_pickup" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="14sp" android:maxLines="2" android:ellipsize="end"/>
        <TextView android:id="@+id/biloo_alert_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#C5D7E9" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>
    <Chronometer android:id="@+id/biloo_alert_deadline" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textColor="#F5C75E" android:textSize="16sp" android:textStyle="bold"/>
</LinearLayout>
